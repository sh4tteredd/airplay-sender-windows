<Window x:Class="AirPlaySender.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AirPlay Sender" Height="680" Width="940"
        MinHeight="560" MinWidth="780"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="150"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="AirPlay Sender" FontSize="26" FontWeight="SemiBold"/>
            <TextBlock Text="Stream Windows audio to a classic AirPlay / RAOP receiver."
                       Foreground="#555" Margin="0,2,0,8"/>
            <Border Background="#F2F4F7" CornerRadius="6" Padding="12,8">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#888" Margin="0,0,8,0"/>
                    <TextBlock x:Name="HeaderStatusText" Text="Idle" FontWeight="SemiBold"/>
                    <TextBlock x:Name="HeaderDetailText" Text="" Foreground="#666" Margin="12,0,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,12,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="AirPlay receivers">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ListBox x:Name="ReceiversList" Grid.Row="0"
                             SelectionChanged="ReceiversList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,4">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Endpoint}" FontSize="11" Foreground="#666"/>
                                    <TextBlock Text="{Binding Model}" FontSize="11" Foreground="#999"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ManualHostInput" Padding="4" ToolTip="host:port"/>
                        <Button Grid.Column="1" Content="Add" Click="AddManualButton_Click" Margin="8,0,0,0"/>
                    </Grid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="RefreshButton" Content="Refresh" Click="RefreshButton_Click"/>
                        <TextBlock x:Name="ReceiverCountText" Foreground="#666" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Column="2" Header="Streaming">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Receiver"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="SelectedReceiverText"
                                   Text="None selected" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Password" Margin="0,10,0,0"/>
                        <PasswordBox Grid.Row="1" Grid.Column="1" x:Name="PasswordInput"
                                     Margin="0,10,0,0" Padding="4"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Capture mode" Margin="0,12,0,0"/>
                        <ComboBox Grid.Row="2" Grid.Column="1" x:Name="CaptureModeCombo"
                                  Margin="0,12,0,0" SelectionChanged="CaptureModeCombo_SelectionChanged"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Audio endpoint" Margin="0,10,0,0"/>
                        <ComboBox Grid.Row="3" Grid.Column="1" x:Name="CaptureDeviceCombo"
                                  Margin="0,10,0,0" DisplayMemberPath="DisplayName"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Volume" Margin="0,12,0,0"/>
                        <Grid Grid.Row="4" Grid.Column="1" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="52"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    ValueChanged="VolumeSlider_ValueChanged"/>
                            <TextBlock Grid.Column="1" x:Name="VolumeText" Text="50%"
                                       HorizontalAlignment="Right"/>
                        </Grid>

                        <StackPanel Grid.Row="5" Grid.Column="1" Margin="0,16,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="StartButton" Content="Start streaming" Click="StartButton_Click"
                                        FontWeight="SemiBold" Background="#0B6BCB" Foreground="White"/>
                                <Button x:Name="StopButton" Content="Stop" Click="StopButton_Click" IsEnabled="False"/>
                            </StackPanel>
                            <CheckBox x:Name="MuteLocalCheckBox" Margin="0,10,0,0"
                                      Content="Mute local speakers while streaming"/>
                        </StackPanel>

                        <Separator Grid.Row="6" Grid.ColumnSpan="2" Margin="0,16,0,12"/>

                        <TextBlock Grid.Row="7" Grid.Column="0" Text="State"/>
                        <TextBlock Grid.Row="7" Grid.Column="1" x:Name="StateText" Text="Idle"/>

                        <TextBlock Grid.Row="8" Grid.Column="0" Text="Capture format" Margin="0,6,0,0"/>
                        <TextBlock Grid.Row="8" Grid.Column="1" x:Name="CaptureFormatText"
                                   Text="-" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>

                        <TextBlock Grid.Row="9" Grid.Column="0" Text="Buffer / drops" Margin="0,6,0,0"/>
                        <TextBlock Grid.Row="9" Grid.Column="1" x:Name="BufferText"
                                   Text="0 frames / 0 dropped" Margin="0,6,0,0"/>
                    </Grid>
                </ScrollViewer>
            </GroupBox>
        </Grid>

        <GroupBox Grid.Row="2" Header="Log">
            <TextBox x:Name="LogTextBox" IsReadOnly="True" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="11" Margin="6"/>
        </GroupBox>
    </Grid>
</Window>
